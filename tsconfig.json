{
    "compilerOptions": {
        "target": "ES2021",
        "module": "ES2020",
        "moduleResolution": "bundler",
        "noEmitOnError": true,
        "esModuleInterop": true,
        "strict": true,
        "removeComments": true,
        "skipLibCheck": true,
        "lib": ["ES2021", "DOM", "DOM.Iterable"]
    },
    "include": ["js/**/*.ts"]
}
